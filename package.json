{
  "engines": { "node": "24.22.1" },
  "name": "format-converter",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "uv run python -m server.format_converter --dev --no-browser",
    "build": "tsc -b && vite build && vite build --config vite.markdown.config.ts",
    "check": "tsc -b",
    "test:explorer": "node --test tests/explorer.test.ts",
    "test:ico": "node --test tests/ico.test.ts",
    "test:feedback": "node --test tests/job-feedback.test.ts",
    "test:navigation": "node --test tests/shortcuts.test.ts tests/preview-navigation.test.ts",
    "test:server": "uv run pytest -q",
    "package:windows": "node scripts/package-windows.mjs",
    "verify:delivery": ".venv/Scripts/python.exe scripts/verify-delivery.py",
    "finalize:delivery": "node scripts/finalize-delivery.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "i18next": "^26.5.2",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
